{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "typescript", "oxc", "vue"],
  "ignorePatterns": [
    "dist",
    "coverage",
    "node_modules",
    "src/wasm/pkg",
    "src/wasm/target",
    "test-results",
    "e2e/playwright-report",
    "apps",
    "packages"
  ],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "args": "none",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none",
        "ignoreRestSiblings": true
      }
    ],
    "unicorn/no-new-array": "off",
    "unicorn/no-useless-fallback-in-spread": "off"
  },
  "overrides": [
    {
      "files": ["e2e/**/*.ts"],
      "rules": {
        "no-empty-pattern": "off"
      }
    }
  ]
}
