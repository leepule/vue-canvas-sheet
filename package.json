{
  "name": "vue-canvas-sheet",
  "version": "0.1.0",
  "description": "A high-performance, modular Canvas-based spreadsheet engine with WASM-powered calculation.",
  "keywords": [
    "spreadsheet",
    "excel",
    "canvas",
    "table",
    "vue",
    "headless",
    "performance",
    "wasm",
    "rust"
  ],
  "author": "Vue-Canvas-Sheet Team",
  "license": "Apache-2.0",
  "packageManager": "npm@11.14.1",
  "homepage": "https://github.com/leepule/vue-canvas-sheet#readme",
  "bugs": {
    "url": "https://github.com/leepule/vue-canvas-sheet/issues"
  },
  "private": false,
  "type": "module",
  "main": "./dist/designer.es.js",
  "module": "./dist/designer.es.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/designer.es.js"
    },
    "./core": {
      "types": "./types/core.d.ts",
      "import": "./dist/core.es.js"
    },
    "./render": {
      "types": "./types/render.d.ts",
      "import": "./dist/render.es.js"
    },
    "./icons": {
      "types": "./types/icons.d.ts",
      "import": "./dist/icons.es.js"
    },
    "./wasm": {
      "types": "./src/wasm/pkg/table_wasm_engine.d.ts",
      "import": "./src/wasm/pkg/table_wasm_engine.js"
    },
    "./style.css": "./dist/vue-canvas-sheet.css"
  },
  "files": [
    "dist",
    "src/wasm/pkg",
    "types",
    "LICENSE",
    "NOTICE",
    "readme.md",
    "README_zh.md"
  ],
  "scripts": {
    "dev": "vite",
    "demo": "vite samples/basic-usage",
    "build": "npm run build:wasm && vite build",
    "build:js": "vite build",
    "build:all": "npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:wasm:real": "vitest run tests/core/WasmRealEngine.spec.js",
    "test:perf": "node scripts/run-performance-tests.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:wasm:compile": "wasm-pack build src/wasm --target web",
    "build:wasm:verify": "node scripts/verify-wasm-build.mjs",
    "check:publish": "node scripts/verify-package.mjs",
    "check:types:runtime": "node scripts/verify-runtime-exports.mjs",
    "collab:server": "node scripts/collab-server.mjs",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ci": "playwright test --config e2e/playwright.config.ts --grep-invert 视觉回归",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "test:e2e:debug": "playwright test --config e2e/playwright.config.ts --debug",
    "test:e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
    "test:e2e:visual": "playwright test --config e2e/playwright.config.ts e2e/specs/visual-regression.spec.ts",
    "test:e2e:visual:update": "playwright test --config e2e/playwright.config.ts e2e/specs/visual-regression.spec.ts --update-snapshots",
    "test:e2e:report": "playwright show-report e2e/playwright-report"
  },
  "dependencies": {
    "@lucide/vue": "^1.43.0",
    "es-toolkit": "^1.44.0",
    "xlsx-js-style": "^1.2.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitest/coverage-v8": "^3.1.0",
    "jsdom": "^26.1.0",
    "sass": "^1.97.3",
    "vite": "^6.2.0",
    "vitest": "^3.1.0",
    "vue": "^3.5.0",
    "ws": "^8.20.1"
  }
}
